{
    "name": "idgateway/laravel-rollout",
    "description": "A package to integrate rollout into your Laravel project.",
    "keywords": ["laravel", "rollout"],
    "license": "MIT",
    "authors": [
        {
            "name": "Jaspaul Bola",
            "email": "jaspaul.b@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^11.0",
        "opensoft/rollout": "^2.2",
        "illuminate/console": "^11.0",
        "illuminate/support": "^11.0",
        "illuminate/database": "^11.0",
        "illuminate/auth": "^11.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^9.7",
        "php-coveralls/php-coveralls": "^2.7",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "Jaspaul\\LaravelRollout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jaspaul\\LaravelRollout\\ServiceProvider"
            ]
        }
    }
}
